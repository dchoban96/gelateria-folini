---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import Allergens from '../components/Allergens.astro';
import { listFlavors, getSettings, CATEGORIES } from '../lib/db';
import { getStatus } from '../lib/season';
import { ui, flavorDesc, type Lang } from '../lib/i18n';
import { whatsapp } from '../lib/site';

interface Props { lang?: Lang }
const { lang = 'it' } = Astro.props;
const t = ui[lang];
const m = t.menu;

const [flavors, settings] = await Promise.all([listFlavors(), getSettings()]);
const status = getStatus(settings);
const groups = CATEGORIES.map((c) => ({ id: c, label: t.cats[c], items: flavors.filter((f) => f.category === c) })).filter((g) => g.items.length);
const tags = [...new Set(flavors.flatMap((f) => f.tags.split(',').map((x) => x.trim()).filter(Boolean)))];
const scoops = flavors.filter((f) => f.category === 'gelato' || f.category === 'sorbetto');

const lines =
  lang === 'it'
    ? {
        one: 'Un gusto solo: così lo senti davvero.',
        mix: 'Sorbetto sotto, crema sopra. Prima fresco, poi tondo.',
        fruit: 'Tutta frutta. Leggero, va bene anche dopo cena.',
        cream: 'Tutte creme. Prendilo con calma.',
        three: 'Tre gusti: chiedi la cialda grande.',
      }
    : {
        one: 'One flavour only: that is how you really taste it.',
        mix: 'Sorbet below, cream on top. Fresh first, round after.',
        fruit: 'All fruit. Light, good even after dinner.',
        cream: 'All creams. Take your time.',
        three: 'Three flavours: ask for the big cone.',
      };
---
<Base title={(lang === 'it' && settings.seo.menu.title) || m.title} description={(lang === 'it' && settings.seo.menu.description) || m.desc} lang={lang} page="menu" image="/img/dulce-de-leche.webp">
  <section class="menu-hero">
    <div class="menu-hero__text">
      <h1 class="display" data-reveal>{m.h1}</h1>
      <p class="lead" data-reveal style="--i:1">{m.lead}</p>
      <nav class="jump" aria-label={lang === 'it' ? 'Categorie' : 'Categories'} data-reveal style="--i:2">
        {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
      </nav>
      {tags.length > 0 && (
        <div class="filters" role="group" aria-label={lang === 'it' ? 'Filtra i gusti' : 'Filter flavours'} data-reveal style="--i:3">
          <button class="chip" type="button" data-filter="" aria-pressed="true">{m.all}</button>
          {tags.map((tag) => <button class="chip" type="button" data-filter={tag} aria-pressed="false">{tag}</button>)}
        </div>
      )}
    </div>

    {scoops.length > 0 && (
      <div class="builder" id="cono" data-lines={JSON.stringify(lines)}>
        <h2 class="builder__title" data-reveal>{m.builderH}</h2>
        <div class="builder__cone" data-reveal style="--i:1">
          <svg viewBox="0 0 200 400" role="img" aria-label={lang === 'it' ? 'Il tuo cono' : 'Your cone'} fill="none" stroke="#421b03" stroke-width="7" stroke-linejoin="round" stroke-linecap="round">
            <path d="M56 290 L100 392 L144 290 Z" fill="#e3a95c" />
            <path d="M72 302 L112 360 M96 296 L124 334 M128 302 L88 360 M104 296 L76 334" stroke-width="4" />
            {[0, 1, 2].map((i) => (
              <g transform={`translate(0 ${172 - i * 78})`}>
                <g class="scoop" data-slot={i}>
                  <path d="M40 118 C28 58 78 26 104 28 C150 30 174 78 160 118 C170 124 166 140 153 137 C146 148 133 133 125 139 C116 149 104 134 94 139 C84 147 72 134 62 139 C50 143 32 134 40 118 Z" />
                </g>
              </g>
            ))}
          </svg>
        </div>
        <div data-reveal style="--i:2">
          <p class="builder__says" aria-live="polite"><b>{m.says}</b> <span data-says>{m.builderHint}</span></p>
          <div class="picks">
            {scoops.map((f) => (
              <button class="pick" type="button" style={`--c:${f.color}`} data-color={f.color} data-cat={f.category} aria-pressed="false">{f.name}</button>
            ))}
          </div>
        </div>
      </div>
    )}
  </section>

  {groups.map((g) => (
    <section class="cat" id={g.id} aria-labelledby={`h-${g.id}`}>
      <div class="cat__top">
        <h2 class="head" id={`h-${g.id}`} data-reveal>{g.label}</h2>
        <p data-reveal style="--i:1" data-count>{m.count(g.items.length)}</p>
      </div>
      <ul class="items">
        {g.items.map((f, i) => (
          <li class="item" id={`g-${f.id}`} data-tags={f.tags} data-reveal style={`--i:${i % 2}`}>
            <Tile flavor={f} />
            <div>
              <div class="item__line">
                <h3 class="item__name">{f.name}</h3>
                {f.price
                  ? <span class="item__price">{f.price}</span>
                  : status.inSeason && f.today && (g.id === 'gelato' || g.id === 'sorbetto') ? <span class="item__price small">{m.today}</span> : null}
              </div>
              <p class="item__desc">{flavorDesc(f, lang)}</p>
              {f.allergens && <Allergens text={f.allergens} id={f.id} name={f.name} lang={lang} />}
              {g.id === 'torta' && <p><a class="link" href={whatsapp(t.waCake(f.name))} rel="noopener">{t.home.order}</a></p>}
            </div>
          </li>
        ))}
      </ul>
      <p class="empty" hidden data-empty>{m.none}</p>
    </section>
  ))}

  <section class="section">
    <p class="prose muted" data-reveal>{m.allergenNote}</p>
  </section>

  <script>
    // Tag filter: hides the items that do not carry the chosen tag.
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const tag = chip.dataset.filter ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        document.querySelectorAll<HTMLElement>('.cat').forEach((cat) => {
          let shown = 0;
          cat.querySelectorAll<HTMLElement>('.item').forEach((item) => {
            const has = !tag || (item.dataset.tags ?? '').split(',').map((s) => s.trim()).includes(tag);
            item.hidden = !has;
            if (has) { shown++; item.classList.add('in'); }
          });
          const empty = cat.querySelector<HTMLElement>('[data-empty]');
          if (empty) empty.hidden = shown > 0;
        });
      }),
    );

    // Cone builder: up to three scoops stack on the cone and Max comments on the pairing.
    const builder = document.querySelector<HTMLElement>('.builder');
    if (builder) {
      const lines = JSON.parse(builder.dataset.lines ?? '{}');
      const says = builder.querySelector<HTMLElement>('[data-says]')!;
      const hint = says.textContent ?? '';
      const slots = [...builder.querySelectorAll<SVGGElement>('.scoop')];
      const picks = [...builder.querySelectorAll<HTMLButtonElement>('.pick')];
      const chosen: HTMLButtonElement[] = [];
      const render = () => {
        slots.forEach((slot, i) => {
          const pick = chosen[i];
          slot.classList.toggle('on', !!pick);
          slot.querySelector('path')!.style.fill = pick ? (pick.dataset.color ?? '#f0b866') : '';
        });
        picks.forEach((b) => {
          const on = chosen.includes(b);
          b.setAttribute('aria-pressed', String(on));
          b.disabled = !on && chosen.length >= 3;
        });
        const cats = chosen.map((b) => b.dataset.cat);
        const sorbets = cats.filter((c) => c === 'sorbetto').length;
        says.textContent =
          chosen.length === 0 ? hint
          : chosen.length === 1 ? lines.one
          : sorbets === chosen.length ? lines.fruit
          : sorbets > 0 ? lines.mix
          : chosen.length === 3 ? lines.three
          : lines.cream;
      };
      picks.forEach((b) =>
        b.addEventListener('click', () => {
          const at = chosen.indexOf(b);
          if (at >= 0) chosen.splice(at, 1);
          else if (chosen.length < 3) chosen.push(b);
          render();
        }),
      );
    }
  </script>
</Base>
