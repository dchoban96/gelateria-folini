---
import Base from '../../layouts/Base.astro';
import Scoop from '../../components/Scoop.astro';
import { listPosts, getSettings } from '../../lib/db';
import { ui } from '../../lib/i18n';
import { fmtDate } from '../../lib/i18n';

const posts = await listPosts();
const seo = (await getSettings()).seo.diary;
const excerpt = (s: string) => (s.length > 170 ? s.slice(0, s.lastIndexOf(' ', 170)) + '…' : s);
---
<Base title={seo.title || ui.it.diary.title} description={seo.description || ui.it.diary.desc} page="diary">
  <section class="page">
    <h1 class="display" data-reveal>il diario di max</h1>
    <p class="lead" style="margin-top:24px;max-width:28ch;--i:1" data-reveal>Gusti nuovi, torte ed esperimenti. Scritto da Max, quando il gelato è già in vetrina.</p>
  </section>
  <section class="section">
    {posts.length === 0
      ? <p class="empty">Il diario è ancora vuoto. Max sta scrivendo il primo appunto: torna presto.</p>
      : (
        <div class="diary">
          <a class="diary__lead" href={`/diario/${posts[0].slug}`} data-reveal>
            {posts[0].image && <div class="tile"><img src={posts[0].image} alt="" width="900" height="675" /></div>}
            <h2 class="post-title">{posts[0].title}</h2>
            <p class="muted">{excerpt(posts[0].body.split('\n')[0])}</p>
            <p class="small muted">{fmtDate(posts[0].published_at, 'it')}</p>
          </a>
          <ul class="diary__list">
            {posts.slice(1).map((post, i) => (
              <li data-reveal style={`--i:${(i % 4) + 1}`}>
                <a href={`/diario/${post.slug}`}>
                  <div class="tile" style="--tile:var(--f-caramel)">{post.image ? <img src={post.image} alt="" width="176" height="176" loading="lazy" /> : <Scoop cone={false} />}</div>
                  <div>
                    <h2 class="post-title">{post.title}</h2>
                    <p class="muted">{excerpt(post.body.split('\n')[0])}</p>
                    <p class="small muted">{fmtDate(post.published_at, 'it')}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
  </section>
</Base>
